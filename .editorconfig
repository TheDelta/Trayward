# https://editorconfig.org
root = true

[*]
max_line_length = 100
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# rustfmt.toml decides for Rust (120 columns)
[{*.rs,*.py}]
indent_size = 4

[*.rs]
max_line_length = 120

# Two trailing spaces are a line break
[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
